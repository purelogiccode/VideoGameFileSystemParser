<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>VideoGameFileSystemParser</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>true</IsPackable>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <EnablePackageValidation>true</EnablePackageValidation>

        <!-- NuGet Package Metadata -->
        <PackageId>VideoGameFileSystemParser</PackageId>
        <Version>1.0.0</Version>
        <Description>Video game file system parsing library for console disc images. Supports ISO 9660, UDF, XDVDFS, OperaFS, CD-i, and other formats through CHD, ISO and raw sector readers.</Description>
        <Title>VideoGameFileSystemParser</Title>
        <Copyright>Copyright (c) 2026 Peterson Fernandes (drpetersonfernandes)</Copyright>
        <PackageProjectUrl>https://github.com/drpetersonfernandes/VideoGameFileSystemParser</PackageProjectUrl>
        <PackageLicenseUrl></PackageLicenseUrl>
        <PackageIcon>icon\icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/drpetersonfernandes/VideoGameFileSystemParser</RepositoryUrl>
        <PackageTags>chd;mame;iso9660;udf;xdvdfs;operafs;cdi;ps1;ps2;ps3;psp;xbox;dreamcast;retro;videogame;disc;filesystem;emulation;emulator;emulator-development;emulators;filesystem;filetree;parser;parsing;parsing-algotithm;parsing-engine;parsing-library;parsing-table;video-game</PackageTags>
        <AssemblyVersion>1.0.0</AssemblyVersion>
        <FileVersion>1.0.0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CHDSharp" Version="1.2.0" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
        <None Include="icon\icon.png" Pack="true" PackagePath="icon\" />
    </ItemGroup>

</Project>
