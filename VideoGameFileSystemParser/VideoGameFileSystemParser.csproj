<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>VideoGameFileSystemParser</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>true</IsPackable>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <EnablePackageValidation>true</EnablePackageValidation>

        <!-- NuGet Package Metadata -->
        <PackageId>VideoGameFileSystemParser</PackageId>
        <Version>1.4.0</Version>
        <Description>Video game file system parsing library for console disc images. Supports ISO 9660, UDF, XDVDFS, OperaFS, CD-i, and other formats through CHD, ISO and raw sector readers.</Description>
        <Title>VideoGameFileSystemParser</Title>
        <Copyright>Copyright (c) 2026 Peterson Fernandes (drpetersonfernandes)</Copyright>
        <PackageProjectUrl>https://github.com/drpetersonfernandes/VideoGameFileSystemParser</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon\icon.png</PackageIcon>
        <RepositoryUrl>https://github.com/drpetersonfernandes/VideoGameFileSystemParser</RepositoryUrl>
        <PackageTags>chd;mame;iso9660;udf;xdvdfs;operafs;cdi;ps1;ps2;ps3;psp;xbox;dreamcast;retro;videogame;disc;filesystem;emulation;emulator;emulator-development;emulators;filesystem;filetree;parser;parsing;parsing-algorithm;parsing-engine;parsing-library;parsing-table;video-game</PackageTags>
        <PackageReleaseNotes>v1.4.0: Added ChdContainer.LastError with detailed open/parse failure diagnostics; Open now reports CHDSharp and track/metadata errors instead of returning silently. Invariant-culture WAV track index parsing and case-insensitive matching for well-known track types (AUDIO/MODE2/CDI/PAD), IP.BIN and PC Engine boot signatures. Includes the v1.3.0 CHDSharp 1.4.3 dependency update.</PackageReleaseNotes>
        <AssemblyVersion>1.4.0</AssemblyVersion>
        <FileVersion>1.4.0</FileVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CHDSharp" Version="1.4.3" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\README.md" Pack="true" PackagePath="\" />
        <None Include="..\WhatsNew.md" Pack="true" PackagePath="\" />
        <None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
        <None Include="icon\icon.png" Pack="true" PackagePath="icon\" />
    </ItemGroup>

</Project>
